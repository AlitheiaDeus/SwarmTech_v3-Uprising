# ==============================================================================
# AlitheiaHive_v3-Uprising .gitignore
# Prevents accidental commits of private specs, machine paths, and runtime artifacts
# ==============================================================================

# Private Specs & Landmarks (Developer & Agent Eyes Only)
internal/
AGENTS.md
AGENTS.MD
agents.md
GEMINI.md
kanban_archive.md
KANBAN_ARCHIVE.md

# Machine-Specific Scripts & Local Environments
run.ps1
*.ps1
*.bat
*.cmd
.env*
*.local

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Editor & OS Metadata
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
tmp/
scratch/
